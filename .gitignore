# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# enviroment
*.local.ts
*.env

.npmrc

# compiled output
dist

# OSV prod-closure lockfiles (synthesized in CI from dist manifests for the scoped scan)
osv-scan/

# api-extractor intermediate report (the committed baseline lives in libs/*/etc/)
libs/*/temp/
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# .context: commit evergreen reference (ops/, decisions, domain, vision, techstack,
# patterns), ignore only the ephemeral work-tracking (tasks/plans/investigations/progress).
/.context/tasks/
/.context/tasks-done/
/.context/plans/
/.context/plans-done/
/.context/investigations/
/.context/progress.md
/.context/ctx-config.json

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.angular
